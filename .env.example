
# Required: replace with a securely generated secret.
# Never use this placeholder as a real secret.
SECUREAPP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# JWT access token lifetime in minutes
SECUREAPP_ACCESS_TOKEN_MINUTES=30

# Default rate limit
SECUREAPP_RATE_LIMIT=5/minute

# Optional endpoint-specific rate limits
SECUREAPP_ITEM_RATE_LIMIT=5/minute
SECUREAPP_REGISTER_RATE_LIMIT=5/minute
SECUREAPP_LOGIN_RATE_LIMIT=5/minute
